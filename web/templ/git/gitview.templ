package git

import (
	"fmt"

	"github.com/Mirac61/lifelog/web/templ/ui"
)

templ GitView(page GitPage) {
	<div class="hero">
		<div class="hero-main">
			<div class="hero-value">{ fmt.Sprintf("%.0f", page.Stats.Total) }</div>
			<div class="hero-label">{ page.TypeLabel }</div>
		</div>
		<div class="hero-stats">
			<div class="hstat"><b>{ fmt.Sprint(page.Stats.ActiveDays) }</b><span>aktive Tage</span></div>
			<div class="hstat"><b>{ fmt.Sprint(page.Stats.LongestStreak) }</b><span>längste Streak</span></div>
			<div class="hstat"><b>{ fmt.Sprintf("%.0f", page.Stats.BestValue) }</b><span>bester Tag{ ui.BestDaySuffix(page.Stats.BestDate) }</span></div>
		</div>
	</div>
	<div class={ "dash", templ.KV("current-year", page.IsCurrentYear) }>
		if page.IsCurrentYear {
			@chartPanel(page)
			@repoPanel(page)
			@prPanel(page)
		} else {
			@chartPanel(page)
			@prPanel(page)
			@repoPanel(page)
		}
	</div>
}

templ chartPanel(page GitPage) {
	<div class="panel" id="chart">
		<div class="box-head">
			<span class="box-title">Heatmap</span>
		</div>
		@Heatmap(page.Heatmap)
	</div>
}

templ prPanel(page GitPage) {
	<div class="panel pr-panel">
		<div class="box-head">
			<span class="box-title-group">
				<span class="box-title">Pull Requests</span>
				<span class="pr-legend">
					<span><i class="pr-dot" data-state="OPEN"></i>Offen</span>
					<span><i class="pr-dot" data-state="MERGED"></i>Merged</span>
					<span><i class="pr-dot" data-state="CLOSED"></i>Geschlossen</span>
				</span>
			</span>
			<span class="box-meta">{ fmt.Sprint(len(page.PRs)) }</span>
		</div>
		if len(page.PRs) > 0 {
			<ul class="prs">
				for _, pr := range page.PRs {
					<li>
						<span class="pr-date">{ ui.FormatShortDate(pr.LocalDate) }</span>
						<span class="pr-dot" data-state={ pr.State } title={ pr.State }></span>
						<a class="pr-title" href={ templ.URL(pr.URL) } target="_blank" rel="noopener" title={ pr.Title }>{ pr.Title }</a>
						<span class="pr-repo">{ pr.Repo }</span>
					</li>
				}
			</ul>
		} else {
			<p class="empty">Keine Pull Requests in { fmt.Sprint(page.Year) }</p>
		}
	</div>
}

templ repoPanel(page GitPage) {
	<div class="panel repo-panel">
		<div class="box-head">
			<span class="box-title">Repos</span>
			<span class="box-meta">{ fmt.Sprint(len(page.Repos)) }</span>
		</div>
		if len(page.Repos) > 0 {
			<ul class="repos">
				for _, r := range page.Repos {
					<li>
						<span class="repo-name" title={ r.Repo }>{ r.Repo }</span>
						<span class="repo-bar" title={ fmt.Sprintf("%.0f%% des aktivsten Repos (%s)", r.Percent, page.Repos[0].Repo) }><i style={ fmt.Sprintf("width:%.1f%%", r.Percent) }></i></span>
						<b>{ fmt.Sprint(r.Commits) }</b>
					</li>
				}
			</ul>
		} else {
			<p class="empty">Keine Commits in { fmt.Sprint(page.Year) }</p>
		}
	</div>
}

// GitViewSwap adds oob tags to sync the header year/controls. Only htmx's AJAX
// swap honors hx-swap-oob, so full page loads must use GitView.
templ GitViewSwap(page GitPage) {
	@GitView(page)
	<span hx-swap-oob="innerHTML:#git-year" style="display:none">{ fmt.Sprint(page.Year) }</span>
	<div hx-swap-oob="innerHTML:#git-controls">
		@GitControls(page)
	</div>
}
