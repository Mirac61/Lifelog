package dashboard

import (
	"fmt"

	"github.com/Mirac61/lifelog/internal/store"
	"github.com/Mirac61/lifelog/web/templ/layout"
	"github.com/Mirac61/lifelog/web/templ/ui"
)

templ Page(stats store.Stats, year int) {
	@layout.Screen("dashboard", nil) {
		@ui.PageHead(ui.Head{Title: "lifelog", Sub: fmt.Sprintf("persönliches Data Warehouse · %d", year)})
		<div class="screen-inner">
			<section class="pane">
				<div class="pane-head">
					<h2 class="pane-label">Dieses Jahr</h2>
					<span class="meta">aus GitHub</span>
				</div>
				<div class="cols-3" style="padding-top: var(--gap-md);">
					<div class="figure figure-lead">
						<span class="figure-num">{ fmt.Sprintf("%.0f", stats.Total) }</span>
						<span class="figure-label">Beiträge</span>
						if stats.BestValue > 0 {
							<span class="figure-note">bester Tag: { fmt.Sprintf("%.0f", stats.BestValue) }{ ui.BestDaySuffix(stats.BestDate) }</span>
						}
					</div>
					<div class="figure">
						<span class="figure-num">{ fmt.Sprint(stats.ActiveDays) }</span>
						<span class="figure-label">aktive Tage</span>
						<span class="figure-note">von { fmt.Sprint(ui.DaysInYear(year)) }</span>
					</div>
					<div class="figure">
						<span class="figure-num">{ fmt.Sprint(stats.LongestStreak) }</span>
						<span class="figure-label">längste Serie</span>
						<span class="figure-note">Tage am Stück</span>
					</div>
				</div>
			</section>
			<section class="pane">
				<div class="pane-head">
					<h2 class="pane-label">Screens</h2>
					<span class="meta">was schon steht</span>
				</div>
				<ul>
					<li>
						<a class="entry" href="/git">
							<span class="entry-num">01</span>
							<span class="entry-body">
								<span class="entry-title"><span class="h3">Git</span><em class="entry-role">Jahr</em></span>
								<span class="entry-desc">Ein Jahr GitHub in Zahlen: jeder Tag, jeder Monat, Repos, Pull Requests — und was die Zahlen sagen.</span>
							</span>
							<span class="entry-go" aria-hidden="true">→</span>
						</a>
					</li>
				</ul>
			</section>
			<div id="detail"></div>
		</div>
	}
}
