package layout

templ Shell(active string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>lifelog</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238FB0AA' stroke-width='1.6'%3E%3Ccircle cx='12' cy='12' r='8.5'/%3E%3Ccircle cx='10.8' cy='13.2' r='4.8'/%3E%3Ccircle cx='9.8' cy='14.2' r='1.5' fill='%238FB0AA' stroke='none'/%3E%3C/svg%3E"/>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class={ "domain-" + active }>
			<aside class="sidebar">
				<a href="/" class="logo" title="lifelog">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
						<circle cx="12" cy="12" r="8.5"></circle>
						<circle cx="10.8" cy="13.2" r="4.8"></circle>
						<circle cx="9.8" cy="14.2" r="1.5" fill="currentColor" stroke="none"></circle>
					</svg>
				</a>
				<nav>
					<a href="/" class={ "nav-item", templ.KV("active", active == "dashboard") } title="Dashboard">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3.5" y="3.5" width="7" height="7" rx="1.6"></rect><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"></rect>
							<rect x="3.5" y="13.5" width="7" height="7" rx="1.6"></rect><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"></rect>
						</svg>
					</a>
					<a href="/git" class={ "nav-item", templ.KV("active", active == "git") } title="Git">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="3.2"></circle><line x1="3" y1="12" x2="8.8" y2="12"></line><line x1="15.2" y1="12" x2="21" y2="12"></line>
						</svg>
					</a>
					<a href="/todos" class={ "nav-item", templ.KV("active", active == "todos") } title="Todos">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="3,7.2 5.6,9.8 10.2,5.2"></polyline><line x1="13" y1="7" x2="21" y2="7"></line>
							<line x1="13" y1="13" x2="21" y2="13"></line><line x1="3" y1="17" x2="21" y2="17"></line>
						</svg>
					</a>
					<a href="/calendar" class={ "nav-item", templ.KV("active", active == "calendar") } title="Kalender">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3.5" y="5" width="17" height="16" rx="2"></rect><line x1="8" y1="3" x2="8" y2="6.6"></line>
							<line x1="16" y1="3" x2="16" y2="6.6"></line><line x1="3.5" y1="10" x2="20.5" y2="10"></line>
						</svg>
					</a>
				</nav>
			</aside>
			<main class="content">
				{ children... }
			</main>
			<div id="tip"></div>
			<script>
			document.addEventListener('mouseover', e => {
				const r = e.target.closest('rect[data-date]');
				const tip = document.getElementById('tip');
				if (!r) { tip.style.opacity = 0; return; }
				const n = r.dataset.value;
				tip.textContent = `${n} ${n === '1' ? 'contribution' : 'contributions'} · ${r.dataset.date}`;
				const box = r.getBoundingClientRect();
				tip.style.left = (box.left + window.scrollX + 6) + 'px';
				tip.style.top = (box.top + window.scrollY - 34) + 'px';
				tip.style.opacity = 1;
			});
			document.addEventListener('click', e => {
				const r = e.target.closest('rect[data-date]');
				if (!r) return;
				document.querySelectorAll('rect.sel').forEach(c => c.classList.remove('sel'));
				r.classList.add('sel');
			});
		</script>
		</body>
	</html>
}
