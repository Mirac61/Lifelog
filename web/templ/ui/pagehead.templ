package ui

// PageHead is the title row a page starts with; the children are its controls.
templ PageHead(h Head) {
	<div class="page-head">
		<h1><span class="dot"></span>{ h.Title } <span>/ <span { h.subAttrs()... }>{ h.Sub }</span></span></h1>
		<div class="controls" { h.controlsAttrs()... }>
			{ children... }
		</div>
	</div>
}
