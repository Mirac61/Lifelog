[
  {
    "label": "run: lifelog",
    "command": "templ generate && go run ./cmd/lifelog",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "dev: watch + reload",
    "command": "templ generate -watch -cmd 'go run ./cmd/lifelog' -proxy 'http://localhost:8080' -open-browser=false",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "templ generate",
    "command": "templ",
    "args": ["generate"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "hide": "on_success"
  },
  {
    "label": "check: generate + build + test",
    "command": "templ generate && go build ./... && go vet ./... && go test ./...",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  }
]
