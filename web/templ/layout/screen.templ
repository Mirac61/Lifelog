package layout

// Screen is the design-system shell from DesignPrototype: a fixed icon rail,
// then the screen. Pages bring their own sticky head via ui.PageHead.
//
// capture is the fixed bar at the bottom edge — a second slot beside the
// children, since only one page has something to capture into. Pass nil and
// the screen keeps the space instead of reserving it.
templ Screen(active string, capture templ.Component) {
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>lifelog</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238FB0AA' stroke-width='1.6'%3E%3Ccircle cx='12' cy='12' r='8.5'/%3E%3Ccircle cx='10.8' cy='13.2' r='4.8'/%3E%3Ccircle cx='9.8' cy='14.2' r='1.5' fill='%238FB0AA' stroke='none'/%3E%3C/svg%3E"/>
			<!-- Vor dem Stylesheet, sonst blitzt beim Laden das helle Thema auf. -->
			<script>
				try { var t = localStorage.getItem('lifelog-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
			</script>
			<link rel="stylesheet" href="/static/lifelog.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<div
				class="app"
				if capture == nil {
					style="--capture-h: 0px"
				}
			>
				<nav class="rail" aria-label="Hauptnavigation">
					<a class="rail-mark" href="/" aria-label="lifelog Übersicht">l</a>
					<a
						href="/"
						class="rail-link"
						data-label="Übersicht"
						aria-label="Übersicht"
						if active == "dashboard" {
							aria-current="page"
						}
					>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5"></rect><rect x="13" y="4" width="7" height="7" rx="1.5"></rect><rect x="4" y="13" width="7" height="7" rx="1.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5"></rect></svg>
					</a>
					<a
						href="/todos"
						class="rail-link"
						data-label="Todos"
						aria-label="Todos"
						if active == "todos" {
							aria-current="page"
						}
					>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3,7.2 5.6,9.8 10.2,5.2"></polyline><line x1="13" y1="7" x2="21" y2="7"></line><line x1="13" y1="13" x2="21" y2="13"></line><line x1="3" y1="17" x2="21" y2="17"></line></svg>
					</a>
					<a
						href="/calendar"
						class="rail-link"
						data-label="Kalender"
						aria-label="Kalender"
						if active == "calendar" {
							aria-current="page"
						}
					>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg>
					</a>
					<a
						href="/git"
						class="rail-link"
						data-label="Git"
						aria-label="Git"
						if active == "git" {
							aria-current="page"
						}
					>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7" cy="6" r="2.4"></circle><circle cx="7" cy="18" r="2.4"></circle><circle cx="17" cy="12" r="2.4"></circle><path d="M7 8.4v7.2M9.4 6h3.1a2 2 0 0 1 2 2v1.8"></path></svg>
					</a>
					<span class="rail-spacer"></span>
					<button type="button" class="rail-link" data-theme-toggle data-label="Hell / Dunkel" aria-label="Zwischen hell und dunkel wechseln">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path></svg>
					</button>
				</nav>
				<main class="screen">
					{ children... }
				</main>
				if capture != nil {
					@capture
				}
			</div>
			<div id="tip"></div>
			<script>
			document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
				const root = document.documentElement;
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				try { localStorage.setItem('lifelog-theme', next); } catch (e) {}
			});

			// Die Heatmap-Zellen tragen ihren Tag als data-Attribut; der Tooltip
			// hängt am document, damit ein htmx-Tausch ihn nicht mitreißt.
			document.addEventListener('mouseover', e => {
				const cell = e.target.closest('[data-date]');
				const tip = document.getElementById('tip');
				if (!cell) { tip.style.opacity = 0; return; }
				tip.textContent = cell.dataset.tip;
				const box = cell.getBoundingClientRect();
				tip.style.left = (box.left + window.scrollX - 8) + 'px';
				tip.style.top = (box.top + window.scrollY - 36) + 'px';
				tip.style.opacity = 1;
			});
			</script>
		</body>
	</html>
}
