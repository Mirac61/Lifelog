package todo

import (
	"time"

	"github.com/Mirac61/lifelog/web/templ/layout"
	"github.com/Mirac61/lifelog/web/templ/ui"
)

// dayLabel names the day "Heute"/"Gestern"/"Morgen", else "Fr 5.9." like the rows.
func dayLabel(day time.Time, today string) string {
	iso := day.Format("2006-01-02")
	if now, err := time.Parse("2006-01-02", today); err == nil {
		switch iso {
		case today:
			return "Heute"
		case now.AddDate(0, 0, -1).Format("2006-01-02"):
			return "Gestern"
		case now.AddDate(0, 0, 1).Format("2006-01-02"):
			return "Morgen"
		}
	}
	return formatDueDate(iso, today)
}

func dayHref(day time.Time) string {
	return "/todos?date=" + day.Format("2006-01-02")
}

// The steps are plain links, not htmx swaps: the day lives in the URL, so a
// navigation keeps it shareable.
func dayStepper(page DayPage, today string) ui.Stepper {
	return ui.Stepper{
		Value:     dayLabel(page.Day, today),
		Wide:      true,
		Prev:      ui.Nav{Href: dayHref(page.Day.AddDate(0, 0, -1))},
		PrevLabel: "Vorheriger Tag",
		Next:      ui.Nav{Href: dayHref(page.Day.AddDate(0, 0, 1))},
		NextLabel: "Nächster Tag",
	}
}

func todayPill() []ui.Pill {
	return []ui.Pill{{Label: "Heute", Nav: ui.Nav{Href: "/todos"}}}
}

templ DateControls(page DayPage, today string) {
	if page.Day.Format("2006-01-02") != today {
		@ui.Pills(todayPill())
	}
	@ui.Steps(dayStepper(page, today))
}

templ Page(page DayPage, today string) {
	@layout.Shell("todos") {
		@ui.PageHead(ui.Head{Title: "Todos", Sub: page.Day.Format("Mon, 2 Jan 2006")}) {
			@DateControls(page, today)
		}
		<div class="board">
			<div class="panel day board-todos">
				@Panel(page, today)
			</div>
			<div class="panel day board-scratch">
				<h3>Notizen</h3>
				<p class="hint">Freitext-Notizen — später.</p>
			</div>
			<div class="panel day calendar-box">
				<h3>Kalender</h3>
				<p class="hint">Tagesplan — später.</p>
			</div>
		</div>
	}
}
