package dashboard

import (
	"fmt"

	"github.com/Mirac61/lifelog/internal/store"
	"github.com/Mirac61/lifelog/web/templ/todo"
	"github.com/Mirac61/lifelog/web/templ/ui"
)

// Day fills #detail when a day is asked for by name.
templ Day(events []store.DayEvent, todos todo.DayPage, today string) {
	<section class="pane">
		<div class="pane-head">
			<h2 class="pane-label">{ ui.LongDate(todos.Day) }</h2>
			<span class="meta">{ fmt.Sprint(len(events)) } Ereignisse</span>
		</div>
		@todo.Panel(todos, today)
		<div class="pane-head">
			<h2 class="pane-label">Ereignisse</h2>
		</div>
		if len(events) > 0 {
			<div class="facts">
				for _, e := range events {
					<div class="fact">
						<span class="fact-k">{ e.Type }</span>
						<span class="fact-v">{ fmt.Sprint(e.Value) } { e.Unit }</span>
					</div>
				}
			</div>
		} else {
			<p class="empty">Keine Ereignisse an diesem Tag.</p>
		}
	</section>
}
