package ui

import "strconv"

// PageHead is the sticky title row; the children are its controls.
templ PageHead(h Head) {
	<header
		class="screen-head"
		if h.ID != "" {
			id={ h.ID }
		}
		if h.OOB {
			hx-swap-oob="true"
		}
	>
		<div class="screen-inner">
			<div class="head-title">
				<h1 class="h1">{ h.Title }</h1>
				if h.Sub != "" {
					<span class="meta">{ h.Sub }</span>
				}
			</div>
			<div class="head-controls">
				{ children... }
			</div>
		</div>
	</header>
}

// Tabs switches what a page shows. Each tab follows its Nav: a link
// navigates, a swap exchanges a fragment in place.
templ Tabs(items []Tab) {
	<div class="tabs" role="tablist">
		for _, t := range items {
			if t.Nav.isLink() {
				<a class="tab" role="tab" aria-selected={ strconv.FormatBool(t.Active) } href={ t.Nav.Href }>
					@tabLabel(t)
				</a>
			} else {
				<button
					type="button"
					class="tab"
					role="tab"
					aria-selected={ strconv.FormatBool(t.Active) }
					hx-get={ t.Nav.Get }
					hx-target={ t.Nav.Target }
					hx-swap={ t.Nav.Swap }
					if t.Nav.Push != "" {
						hx-push-url={ t.Nav.Push }
					}
				>
					@tabLabel(t)
				</button>
			}
		}
	</div>
}

templ tabLabel(t Tab) {
	{ t.Label }
	if t.Count != "" {
		<span class="meta">{ t.Count }</span>
	}
}

templ Steps(s Stepper) {
	<div class="stepper" role="group" aria-label={ s.Group }>
		@step(s.Prev, s.PrevLabel, "‹")
		<span class="stepper-now">{ s.Label }</span>
		@step(s.Next, s.NextLabel, "›")
	</div>
}

templ step(n Nav, label, glyph string) {
	if n.isLink() {
		<a aria-label={ label } href={ n.Href }>{ glyph }</a>
	} else if n.isSwap() {
		<button
			type="button"
			aria-label={ label }
			hx-get={ n.Get }
			hx-target={ n.Target }
			hx-swap={ n.Swap }
			if n.Push != "" {
				hx-push-url={ n.Push }
			}
		>{ glyph }</button>
	} else {
		<button type="button" aria-label={ label } disabled>{ glyph }</button>
	}
}
