package todo

import (
	"fmt"
	"time"

	"github.com/Mirac61/lifelog/internal/store"
	"github.com/Mirac61/lifelog/web/templ/ui"
)

func nextStatus(s string) string {
	if s == "done" {
		return "todo"
	}
	return "done"
}

// Clicking the text toggles in_progress, so there is no second button.
func nextOnRowClick(s string) string {
	if s == "in_progress" {
		return "todo"
	}
	return "in_progress"
}

// Mutating handlers re-render this out of band.
templ Planned(minutes int, oob bool) {
	<span
		class="meta"
		id="planned"
		if oob {
			hx-swap-oob="true"
		}
	>
		if minutes > 0 {
			{ formatDuration(minutes) + " offen" }
		}
	</span>
}

func formatDuration(minute int) string {
	hour, minutes := minute/60, minute%60
	switch {
	case hour > 0 && minutes > 0:
		return fmt.Sprintf("%dh%dm", hour, minutes)
	case hour > 0:
		return fmt.Sprintf("%dh", hour)
	default:
		return fmt.Sprintf("%dm", minutes)
	}
}

// formatDueDate renders "Fr 5.9." for the current year, "Fr 5.9.2027" otherwise.
func formatDueDate(iso, today string) string {
	d, err := time.Parse("2006-01-02", iso)
	if err != nil {
		return iso
	}
	out := fmt.Sprintf("%s %d.%d.", ui.WeekdayShort[d.Weekday()], d.Day(), int(d.Month()))
	if now, err := time.Parse("2006-01-02", today); err == nil && d.Year() != now.Year() {
		out += fmt.Sprint(d.Year())
	}
	return out
}

func isOverdue(t store.Todo, today string) bool {
	return t.DueDate.Valid && t.DueDate.String < today && t.Status != "done"
}

templ Item(t store.Todo, today string) {
	<li class="task" data-done={ fmt.Sprintf("%t", t.Status == "done") } data-state={ t.Status }>
		<button
			type="button"
			class="check"
			role="checkbox"
			aria-checked={ fmt.Sprintf("%t", t.Status == "done") }
			aria-label={ t.Text + " abhaken" }
			hx-post={ fmt.Sprintf("/todos/%d/%s", t.ID, nextStatus(t.Status)) }
			hx-target="closest li"
			hx-swap="outerHTML"
		>
			<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.3 4.6 9 10 3"></path></svg>
		</button>
		<span
			class="task-title"
			title="Anfangen / zurücklegen"
			hx-post={ fmt.Sprintf("/todos/%d/%s", t.ID, nextOnRowClick(t.Status)) }
			hx-target="closest li"
			hx-swap="outerHTML"
		>{ t.Text }</span>
		<span class="task-meta">
			if t.Estimate.Valid {
				<span class="task-due num">{ formatDuration(int(t.Estimate.Int64)) }</span>
			}
			if t.DueDate.Valid && t.DueDate.String != today {
				<span class={ "task-due", "num", templ.KV("is-overdue", isOverdue(t, today)) }>{ formatDueDate(t.DueDate.String, today) }</span>
			}
			if t.Category.Valid {
				<span class="tag">#{ t.Category.String }</span>
			}
			<button
				type="button"
				class="icon-btn"
				aria-label={ t.Text + " löschen" }
				hx-delete={ fmt.Sprintf("/todos/%d", t.ID) }
				hx-target="closest li"
				hx-swap="outerHTML"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14M10 7V5h4v2M8 7l.7 12h6.6L16 7"></path></svg>
			</button>
		</span>
	</li>
}

// ItemUpdate answers every mutation: the row, plus the budget out of band.
templ ItemUpdate(t store.Todo, planned int, today string) {
	@Item(t, today)
	@Planned(planned, true)
}

// ItemUpcoming answers a create due past the shown day: the row drops into
// "Kommende" out of band, plus the budget.
templ ItemUpcoming(t store.Todo, planned int, today string) {
	<ol hx-swap-oob="beforeend:#todo-upcoming">
		@Item(t, today)
	</ol>
	@Planned(planned, true)
}

// Panel is the day's list — also used inside the dashboard's day detail.
templ Panel(page DayPage, today string) {
	<section class="pane">
		<div class="pane-head">
			<h2 class="pane-label">Aufgaben</h2>
			@Planned(page.Planned, false)
		</div>
		<ol id="todo-today">
			for _, t := range page.Todos {
				@Item(t, today)
			}
		</ol>
		if len(page.Todos) == 0 {
			<p class="empty">Nichts für diesen Tag — tipp unten was ein.</p>
		}
	</section>
	<section class="pane">
		<div class="pane-head">
			<h2 class="pane-label">Kommende</h2>
			<span class="meta">nach diesem Tag fällig</span>
		</div>
		<ol id="todo-upcoming">
			for _, t := range page.Upcoming {
				@Item(t, today)
			}
		</ol>
		if len(page.Upcoming) == 0 {
			<p class="empty">Nichts geplant.</p>
		}
	</section>
}

// Capture is the bar at the bottom edge. It writes into the shown day, and the
// new row lands at the end of that day's list — unless it is due later, then
// the handler drops it into "Kommende" instead.
templ Capture(page DayPage) {
	<form
		class="capture"
		autocomplete="off"
		hx-post="/todos"
		hx-target="#todo-today"
		hx-swap="beforeend"
		hx-on::after-request="this.reset()"
	>
		<div class="capture-inner">
			<input type="hidden" name="date" value={ page.Day.Format("2006-01-02") }/>
			<label for="capture-input" class="visually-hidden">Neue Aufgabe</label>
			<input
				class="capture-input"
				id="capture-input"
				name="text"
				type="text"
				placeholder="Wäsche aufhängen 15m #haushalt @05.09.2026"
			/>
			<button type="submit" class="btn">Anlegen ↵</button>
		</div>
	</form>
}
